generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "mysql"
}

model Product{
    id String @id @default(uuid())
    title String
    price Int @default(0)
    rating Int @default(0)
    description String
    mainImage String
    slug String @unique
    manufacturer String
    categoryID String
    category Category @relation(fields: [categoryID], references: [id])
    inStock Int @default(1)
}

model Image {
  imageID   String @id @default(uuid())
  productID String
  image     String
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String?
  role String @default("user")
}

model Order {
  id             String  @id @default(uuid())
  name           String
  lastname       String
  phone          String
  email          String  @unique

  company        String?
  address        String
  apartment      String?

  city           String
  country        String
  postalCode     Int

  cardName       String
  cardNumber     String
  expirationDate String
  cvc            String
}
model Category {
  id   String @id @default(uuid())
  name String
  products Product[]
}