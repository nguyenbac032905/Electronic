generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "mysql"
}

model Product{
    id String @id @default(uuid())
    title String
    price Int @default(0)
    rating Int @default(0)
    description String
    mainImage String
}

model Image {
  imageID   String @id @default(uuid())
  articleID String
  image     String
}